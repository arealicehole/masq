# ============================================
# Masq - Zero-Compilation GPU Image
# ============================================

# Use official PyTorch image which has 90% of the weight already
FROM pytorch/pytorch:2.5.1-cuda12.1-cudnn9-runtime

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies for OpenCV and BasicSR
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    git \
    wget \
    build-essential \
    libmagic1 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# 1. Install heavy AI stuff individually (Fast because we have PyTorch already)
RUN pip install --no-cache-dir opencv-python-headless numpy==1.26.4
RUN pip install --no-cache-dir "git+https://github.com/xinntao/BasicSR.git"
RUN pip install --no-cache-dir realesrgan --no-deps

# 2. Install app dependencies
COPY requirements-lean.txt .
RUN pip install --no-cache-dir -r requirements-lean.txt

# 3. Copy application code
COPY . .

# 4. Pre-download models (Small and fast)
RUN mkdir -p /root/.u2net && \
    python -c "from rembg import new_session; new_session('birefnet-general'); new_session('isnet-general-use')" && \
    wget https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth -P /root/.u2net/ && \
    wget https://github.com/xinntao/Real-ESRGAN/releases/download/v0.2.2.4/RealESRGAN_x4plus_anime_6B.pth -P /root/.u2net/

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TEMP_DIR=/tmp/img-proc \
    USE_GPU=true \
    MODELS_CONFIG_PATH=config/models-lean.yaml

# Expose port
EXPOSE 8000

# Run FastAPI
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
